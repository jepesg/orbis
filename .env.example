# Configurações do Banco de Dados PostgreSQL (Supabase)
# Exemplo com Pooler do Supabase (Porta 6543 / Session ou Transaction mode):
# DATABASE_URL=postgresql://postgres.seu-projeto:sua-senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#
# Exemplo com Conexão Direta (Porta 5432):
# DATABASE_URL=postgresql://postgres:sua-senha@db.seu-projeto.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbis

# Chave secreta para criptografia dos tokens JWT (gere uma segura em produção)
SECRET_KEY=sua_chave_secreta_super_segura_aqui_com_pelo_menos_32_caracteres

# Algoritmo JWT
ALGORITHM=HS256

# Tempo de expiração do token em minutos (1440 min = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
